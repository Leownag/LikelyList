# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local editor / assistant configuration
# Personal tooling, not part of the project. Kept on disk, out of the repo.
.claude/
CLAUDE.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.dev.vars
.dev.vars.*

# cloudflare
# cloudflare-env.d.ts is generated by `npm run cf-typegen` but committed, so a
# fresh clone can typecheck without Cloudflare credentials.
/.open-next/
/.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts
email-preview.*
