# Copy to .env.local for `next dev`, and to .dev.vars for `wrangler dev`.
# In production these are set with `wrangler secret put <NAME>`.

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API. The service role key bypasses RLS and is used only
# by the cron path; it must never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ticketmaster -----------------------------------------------------------
# https://developer.ticketmaster.com/ -> My Apps -> Consumer Key.
# Default quota: 5 requests/second, 5000 requests/day.
TICKETMASTER_API_KEY=

# --- OpenAI -----------------------------------------------------------------
# Used only for feed screenshot extraction, never in the weekly cron.
OPENAI_API_KEY=
# Any vision-capable model. Cheap tiers are plenty for poster extraction.
OPENAI_VISION_MODEL=gpt-5.6-luna
# Per-user, per-day cap on feed uploads. Guards our own OpenAI bill.
FEED_DAILY_UPLOAD_LIMIT=90
# Per-user, per-day cap on the artist search box. Typing spends Ticketmaster's
# 5000/day quota, and this keeps one person from starving the Friday send.
ARTIST_DAILY_SEARCH_LIMIT=60

# --- Spotify ----------------------------------------------------------------
# developer.spotify.com/dashboard -> Create app.
#
# Redirect URIs must list BOTH of these exactly, because the redirect is derived
# from the request origin so localhost works without reconfiguring anything:
#   https://likelylist.tech/api/spotify/callback
#   http://localhost:3000/api/spotify/callback
#
# Scope requested is user-top-read and nothing else. Leave these blank and the
# Connect button simply does not appear — nothing else changes.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- YouTube ----------------------------------------------------------------
# Google Cloud Console -> enable "YouTube Data API v3" -> create an API key.
# search.list is capped at 100 CALLS per day in its own quota bucket, so we
# cache artist -> channel mappings permanently and degrade to a search deep
# link once the budget is spent.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_SEARCH_LIMIT=90

# --- Email ------------------------------------------------------------------
RESEND_API_KEY=
# Must be on a Resend-verified domain. The sending subdomain is deliberately not
# the apex: it keeps digest reputation off likelylist.tech itself.
EMAIL_FROM="LikelyList <digest@mail.yourdomain.com>"
# Receives RFC 8058 mailto: unsubscribes. Outlook and iOS Mail honour only the
# mailto: form, so omitting this loses the native unsubscribe button there.
#
# It must be an address that can actually RECEIVE mail — the mail client sends an
# email here rather than opening a link. Cloudflare Email Routing is free and the
# domain is already on Cloudflare, so the simplest setup is:
#
#   Cloudflare → likelylist.tech → Email Routing → Routes
#   unsubscribe@likelylist.tech  →  forward to your real inbox
#
# Deliberately on the apex rather than mail.likelylist.tech: Email Routing puts its
# own MX records on whatever it handles, and keeping inbound on the apex leaves the
# sending subdomain's records untouched by Resend.
#
# Incoming mail arrives with the subject "unsubscribe <user-id>", so the account to
# switch off is identifiable. Someone has to act on it — see the note in the README.
EMAIL_UNSUBSCRIBE_MAILTO=unsubscribe@likelylist.tech

# --- Site -------------------------------------------------------------------
# Use http://localhost:3000 in .env.local for development —
# it is read at runtime, so no domain is baked into the build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Secrets ----------------------------------------------------------------
# Shared secret for manually triggering /api/cron/digest.
#   openssl rand -hex 32
CRON_SECRET=
# Signs one-click unsubscribe tokens.
#   openssl rand -hex 32
UNSUBSCRIBE_HMAC_SECRET=
