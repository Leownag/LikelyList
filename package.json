{
  "name": "likelylist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "preview:email": "tsx scripts/preview-email.ts",
    "preflight": "tsx --env-file=.env.local scripts/preflight.ts",
    "security:check": "tsx --env-file=.env.local scripts/security-check.ts",
    "tm:probe": "tsx --env-file=.env.local scripts/tm-probe.ts",
    "seed:genres": "tsx --env-file=.env.local scripts/seed-genres.ts",
    "seed:cities": "tsx --env-file=.env.local scripts/seed-cities.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  }
}
