{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "likelylist",

  // Custom worker (see worker.ts): re-exports the OpenNext `fetch` handler and
  // adds a `scheduled` handler. The OpenNext-generated worker only exports
  // `fetch`, so a cron trigger cannot reach it without this indirection.
  "main": "./worker.ts",

  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Bound here rather than in the dashboard so a deploy from a clean checkout
  // lands on the real domain without anyone remembering to click anything.
  // `custom_domain` makes Cloudflare own the apex record; there is deliberately
  // no workers.dev subdomain, so this is the only way in.
  "routes": [{ "pattern": "likelylist.tech", "custom_domain": true }],

  // The account needs a workers.dev subdomain registered before the cron
  // schedules API will accept anything, but the app must not be reachable there:
  // a second live origin serving the same pages contradicts every canonical tag,
  // which are baked from NEXT_PUBLIC_SITE_URL at build time.
  "workers_dev": false,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "likelylist"
    }
  ],

  "triggers": {
    "crons": [
      // Weekly run builder. Creates the digest run, refreshes the Ticketmaster
      // event cache once per DISTINCT subscribed city, and enqueues one job per
      // opted-in subscriber. The drainer below decides *when* each subscriber
      // actually receives their email, based on their own timezone. That keeps
      // delivery at a sane local hour and sidesteps DST (cron expressions are
      // always UTC).
      //
      // Tuesday 19:00 UTC, which is not an arbitrary hour. Everyone is sent on
      // their own local Wednesday morning, and that span is bounded by the
      // supported zones: Tokyo (UTC+9) at 06:00 is Tuesday 21:00 UTC, Honolulu
      // (UTC-10) at 11:00 is Wednesday 21:00 UTC. Building two hours before the
      // earliest send leaves margin for the hour Cloudflare spreads a trigger
      // across, and the last send still lands 26 hours later — inside the
      // 36-hour event cache TTL the whole run reads from.
      "0 19 * * 2",

      // Queue drainer. Sends the queued jobs in small batches whose local time
      // has come, and purges expired event cache rows. Runs every 5 minutes so
      // the pipeline is self-healing: if an invocation dies partway through,
      // the next one picks up the remaining jobs. A cron with an interval below
      // one hour gets 30s of CPU time on Workers Paid.
      "*/5 * * * *"
    ]
  },

  "observability": {
    "enabled": true
  }
}
